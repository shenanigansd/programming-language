# Amarok-defined helpers in the `std::math` module.
#
# Loaded via `use std::math;` which flat-merges these top-level
# definitions into the importing module.

def add(a, b) {
    return a + b;
}

def sub(a, b) {
    return a - b;
}

def mul(a, b) {
    return a * b;
}

def square(x) {
    return x * x;
}
